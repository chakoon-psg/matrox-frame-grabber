<Window x:Class="MatroxFrameGrabber.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MatroxFrameGrabber.Views"
        xmlns:milwpf="milwpf"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        Title="Matrox Rapixo CXP - 4 Camera Viewer"
        Width="1360" Height="820"
        Background="{StaticResource BgBrush}">

    <Grid>
        <!-- Main content: toolbar + 2x2 camera grid -->
        <DockPanel x:Name="MainContent" LastChildFill="True">
            <!-- Toolbar: only the always-needed actions stay visible. Occasional settings (RAW
                 auto-stop/segment, output resolution) live behind the ⚙ popup; per-camera values
                 (exposure, acq rate, trigger, WB) live in each pane with their own "All" button. -->
            <DockPanel DockPanel.Dock="Top" Margin="8,6,8,4" LastChildFill="True">
                <!-- System / digitizer summary pinned to the right -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding SystemStatus}" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="8,0,0,0" />

                <WrapPanel Orientation="Horizontal">
                    <!-- Acquisition -->
                    <Button Content="Start All" Style="{StaticResource AccentButton}" MinWidth="80" Padding="10,4"
                            Command="{Binding StartAllCommand}" />
                    <Button Content="Stop All" MinWidth="80" Padding="10,4" Margin="0,0,4,0"
                            Click="StopAll_Click" ToolTip="Stop all cameras (confirms if any are recording)" />

                    <Border Width="1" Height="22" Background="{StaticResource BorderBrushColor}" Margin="8,0" VerticalAlignment="Center" />

                    <!-- Recording (red = live H.264, orange = RAW lossless) -->
                    <ToggleButton Content="● Rec All" Style="{StaticResource RecToggle}" Padding="10,4"
                                  Margin="0,0,4,0" Click="RecordAll_Click" IsChecked="{Binding AnyRecording, Mode=OneWay}"
                                  IsEnabled="{Binding AnyCanRecord}"
                                  ToolTip="Record all running cameras (live color H.264, may drop frames at high fps)" />
                    <ToggleButton Content="◆ RAW All" Style="{StaticResource RawToggle}" Padding="10,4"
                                  Margin="0,0,4,0" Click="RawAll_Click" IsChecked="{Binding AnyRawRecording, Mode=OneWay}"
                                  IsEnabled="{Binding AnyCanRecord}"
                                  ToolTip="Lossless RAW record all cameras: every frame at full fps → color MP4" />

                    <!-- Recording settings popup (RAW auto-stop / segment length / output resolution) -->
                    <Button x:Name="RecSettingsButton" Padding="8,4" Click="RecSettings_Click"
                            ToolTip="Recording settings — RAW auto-stop, segment length, output resolution">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Rec" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Popup x:Name="RecSettingsPopup" PlacementTarget="{Binding ElementName=RecSettingsButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushColor}"
                                BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,4,0,0">
                            <StackPanel MinWidth="230">
                                <TextBlock Text="Recording settings" FontWeight="SemiBold"
                                           Foreground="#E0E0E0" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="RAW auto-stop"
                                               VerticalAlignment="Center" Margin="0,0,12,7" Foreground="#D0D0D0" />
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,7">
                                        <TextBox Width="46" VerticalContentAlignment="Center"
                                                 Text="{Binding RawSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="RAW recording auto-stop, in seconds (0 = manual / continuous)" />
                                        <TextBlock Text="s (0=∞)" VerticalAlignment="Center" Margin="5,0,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="RAW segment"
                                               VerticalAlignment="Center" Margin="0,0,12,7" Foreground="#D0D0D0" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,7">
                                        <TextBox Width="46" VerticalContentAlignment="Center"
                                                 Text="{Binding RawSegSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Length of each RAW MP4 segment, in seconds (min 5)." />
                                        <TextBlock Text="s" VerticalAlignment="Center" Margin="5,0,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Resolution"
                                               VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#D0D0D0" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="110"
                                              VerticalContentAlignment="Center"
                                              ItemsSource="{Binding ResolutionOptions}"
                                              SelectedItem="{Binding Output.Resolution}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Border Width="1" Height="22" Background="{StaticResource BorderBrushColor}" Margin="8,0" VerticalAlignment="Center" />

                    <!-- Output folder -->
                    <Button Padding="8,4" Margin="0,0,4,0" Click="OpenFolder_Click"
                            ToolTip="{Binding Output.OutputFolder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Open" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="Browse…" Padding="8,4" Click="BrowseFolder_Click"
                            ToolTip="Change the output folder for snapshots and recordings" />
                </WrapPanel>
            </DockPanel>

            <Grid Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <local:CameraPaneView Grid.Row="0" Grid.Column="0" DataContext="{Binding Channels[0]}"
                                      FullscreenRequested="Pane_FullscreenRequested"
                                      ApplyToAllRequested="Pane_ApplyToAllRequested" />
                <local:CameraPaneView Grid.Row="0" Grid.Column="1" DataContext="{Binding Channels[1]}"
                                      FullscreenRequested="Pane_FullscreenRequested"
                                      ApplyToAllRequested="Pane_ApplyToAllRequested" />
                <local:CameraPaneView Grid.Row="1" Grid.Column="0" DataContext="{Binding Channels[2]}"
                                      FullscreenRequested="Pane_FullscreenRequested"
                                      ApplyToAllRequested="Pane_ApplyToAllRequested" />
                <local:CameraPaneView Grid.Row="1" Grid.Column="1" DataContext="{Binding Channels[3]}"
                                      FullscreenRequested="Pane_FullscreenRequested"
                                      ApplyToAllRequested="Pane_ApplyToAllRequested" />
            </Grid>
        </DockPanel>

        <!-- Fullscreen overlay: single display bound to the selected camera -->
        <Grid x:Name="FullscreenOverlay" Visibility="Collapsed" Background="Black">
            <!-- The MILWPFDisplay is created lazily in code-behind (only with a valid DisplayId). -->
            <Border x:Name="FullscreenBorder" Background="Black"
                    SizeChanged="FullscreenBorder_SizeChanged"
                    PreviewMouseLeftButtonDown="FullscreenBorder_PreviewMouseLeftButtonDown" />
            <Border Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Top"
                    CornerRadius="0,0,6,6" Padding="12,4">
                <TextBlock x:Name="FullscreenTitle" Foreground="White" FontSize="13"
                           Text="Double-click or press ESC to exit fullscreen" />
            </Border>
            <Button Content="✕ Exit" Click="ExitFullscreen_Click" Padding="10,4"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" />
        </Grid>
    </Grid>
</Window>
