<Window x:Class="MatroxFrameGrabber.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MatroxFrameGrabber.Views"
        xmlns:milwpf="milwpf"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        Title="Matrox Rapixo CXP - 4 Camera Viewer"
        Width="1360" Height="820"
        Background="{StaticResource BgBrush}">

    <Grid>
        <!-- Main content: toolbar + 2x2 camera grid -->
        <DockPanel x:Name="MainContent" LastChildFill="True">
            <!-- WrapPanel so the toolbar reflows onto a 2nd line instead of clipping on narrow windows.
                 Three groups (acquisition | recording | output+settings) separated by dividers. -->
            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4">
                <!-- Group 1: acquisition -->
                <Button Content="Start All" Style="{StaticResource AccentButton}" MinWidth="80" Padding="10,4"
                        Command="{Binding StartAllCommand}" />
                <Button Content="Stop All" MinWidth="80" Padding="10,4" Margin="0,0,4,0"
                        Click="StopAll_Click" ToolTip="Stop all cameras (confirms if any are recording)" />

                <Border Width="1" Height="22" Background="{StaticResource BorderBrushColor}" Margin="8,0" VerticalAlignment="Center" />

                <!-- Group 2: recording (red = live H.264, orange = RAW lossless) -->
                <ToggleButton Content="● Rec All" Style="{StaticResource RecToggle}" Padding="10,4"
                              Margin="0,0,4,0" Click="RecordAll_Click" IsChecked="{Binding AnyRecording, Mode=OneWay}"
                              IsEnabled="{Binding AnyCanRecord}"
                              ToolTip="Record all running cameras (live color H.264, may drop frames at high fps)" />
                <ToggleButton Content="◆ RAW All" Style="{StaticResource RawToggle}" Padding="10,4"
                              Margin="0,0,6,0" Click="RawAll_Click" IsChecked="{Binding AnyRawRecording, Mode=OneWay}"
                              IsEnabled="{Binding AnyCanRecord}"
                              ToolTip="Lossless RAW record all cameras: every frame at full fps → color MP4" />
                <TextBlock Text="auto-stop" VerticalAlignment="Center" Margin="0,0,3,0" Foreground="{StaticResource MutedTextBrush}" />
                <TextBox Width="30" VerticalContentAlignment="Center"
                         Text="{Binding RawSeconds, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="RAW recording auto-stop, in seconds (0 = manual stop)" />
                <TextBlock Text="s (0=∞)" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="{StaticResource MutedTextBrush}" />

                <Border Width="1" Height="22" Background="{StaticResource BorderBrushColor}" Margin="8,0" VerticalAlignment="Center" />

                <!-- Group 3: output + global camera settings -->
                <TextBlock Text="Output:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Width="240" VerticalContentAlignment="Center" IsReadOnly="True"
                         Text="{Binding Output.OutputFolder, Mode=OneWay}"
                         ToolTip="{Binding Output.OutputFolder}" />
                <Button Content="Browse…" Padding="8,4" Margin="4,0,4,0" Click="BrowseFolder_Click" />
                <Button Content="Open" Padding="8,4" Margin="0,0,8,0" Click="OpenFolder_Click" />
                <TextBlock Text="Resolution:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="100" VerticalContentAlignment="Center"
                          ItemsSource="{Binding ResolutionOptions}"
                          SelectedItem="{Binding Output.Resolution}" />
                <TextBlock Text="Acq Rate:" VerticalAlignment="Center" Margin="12,0,4,0" />
                <TextBox Width="44" VerticalContentAlignment="Center"
                         Text="{Binding GlobalAcqRate, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="fps" VerticalAlignment="Center" Margin="4,0,4,0"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Button Content="Set all" Padding="10,4"
                        Command="{Binding SetAllAcqRateCommand}" IsEnabled="{Binding AnyCanAcqRate}"
                        ToolTip="Apply this AcquisitionFrameRate (fps) to all cameras" />
            </WrapPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding SystemStatus}"
                       Margin="8,0,8,4" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />

            <Grid Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <local:CameraPaneView Grid.Row="0" Grid.Column="0" DataContext="{Binding Channels[0]}"
                                      FullscreenRequested="Pane_FullscreenRequested" />
                <local:CameraPaneView Grid.Row="0" Grid.Column="1" DataContext="{Binding Channels[1]}"
                                      FullscreenRequested="Pane_FullscreenRequested" />
                <local:CameraPaneView Grid.Row="1" Grid.Column="0" DataContext="{Binding Channels[2]}"
                                      FullscreenRequested="Pane_FullscreenRequested" />
                <local:CameraPaneView Grid.Row="1" Grid.Column="1" DataContext="{Binding Channels[3]}"
                                      FullscreenRequested="Pane_FullscreenRequested" />
            </Grid>
        </DockPanel>

        <!-- Fullscreen overlay: single display bound to the selected camera -->
        <Grid x:Name="FullscreenOverlay" Visibility="Collapsed" Background="Black">
            <!-- The MILWPFDisplay is created lazily in code-behind (only with a valid DisplayId). -->
            <Border x:Name="FullscreenBorder" Background="Black"
                    SizeChanged="FullscreenBorder_SizeChanged"
                    PreviewMouseLeftButtonDown="FullscreenBorder_PreviewMouseLeftButtonDown" />
            <Border Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Top"
                    CornerRadius="0,0,6,6" Padding="12,4">
                <TextBlock x:Name="FullscreenTitle" Foreground="White" FontSize="13"
                           Text="Double-click or press ESC to exit fullscreen" />
            </Border>
            <Button Content="✕ Exit" Click="ExitFullscreen_Click" Padding="10,4"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" />
        </Grid>
    </Grid>
</Window>
