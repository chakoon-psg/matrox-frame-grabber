<Window x:Class="MatroxFrameGrabber.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MatroxFrameGrabber.Views"
        xmlns:milwpf="milwpf"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        Title="Matrox Rapixo CXP - 4 Camera Viewer"
        Width="1360" Height="820"
        Background="{StaticResource BgBrush}">

    <Grid>
        <!-- Main content: toolbar + 2x2 camera grid -->
        <DockPanel x:Name="MainContent" LastChildFill="True">
            <!-- Toolbar: only the always-needed actions stay visible. Occasional settings (RAW
                 auto-stop/segment, output resolution) live behind the ⚙ popup; per-camera values
                 (exposure, acq rate, trigger, WB) live in each pane with their own "All" button. -->
            <DockPanel DockPanel.Dock="Top" Margin="8,6,8,4" LastChildFill="True">
                <!-- System / digitizer summary pinned to the right -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding SystemStatus}" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="8,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding BandwidthText}" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" />
                <!-- Blank unless a run is being logged; the row count moving is the only proof
                     from the UI that the measurement file is actually being written. -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding MeasurementLogText}" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" />

                <WrapPanel Orientation="Horizontal">
                    <!-- Acquisition -->
                    <Button Content="Start All" Style="{StaticResource AccentButton}" MinWidth="80" Padding="10,4"
                            Command="{Binding StartAllCommand}" />
                    <Button Content="Stop All" MinWidth="80" Padding="10,4" Margin="0,0,4,0"
                            Click="StopAll_Click" ToolTip="Stop all cameras (confirms if any are recording)" />

                    <Border Width="1" Height="22" Background="{StaticResource BorderBrushColor}" Margin="8,0" VerticalAlignment="Center" />

                    <!-- Recording -->
                    <ToggleButton Content="● Rec All" Style="{StaticResource RecToggle}" Padding="10,4"
                                  Margin="0,0,4,0" Click="RecordAll_Click" IsChecked="{Binding AnyRecording, Mode=OneWay}"
                                  IsEnabled="{Binding AnyCanRecord}"
                                  ToolTip="Record all running cameras (live color H.264, may drop frames at high fps)" />
                    <!-- Application settings, in a window: the list only grows from here, and the
                         per-camera settings already open in one. See AppSettingsWindow. -->
                    <Button Padding="8,4" Click="AppSettings_Click"
                            AutomationProperties.Name="Settings"
                            ToolTip="설정 — 녹화 백엔드, 출력 폴더, 표시 fps">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="22" Background="{StaticResource BorderBrushColor}" Margin="8,0" VerticalAlignment="Center" />

                    <!-- Output folder. Browse moved into Settings: the path is set once, and
                         there is more than one folder coming. -->
                    <Button Padding="8,4" Margin="0,0,4,0" Click="OpenFolder_Click"
                            ToolTip="{Binding Output.OutputFolder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Open" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                </WrapPanel>
            </DockPanel>

            <!-- Always visible: the brightness strip is the only place a slow exposure drift shows
                 up, and a graph nobody remembers to open cannot catch drift. Its ToolTip carries
                 the per-channel sampling diagnostics, filled in by RedrawBrightness. -->
            <Border x:Name="BrightnessStrip" DockPanel.Dock="Bottom" Height="110" Margin="2,0,2,2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Gutter for the y-axis labels. They used to be drawn inside the plot
                             canvas, where the data lines ran straight across them; a separate
                             column makes the separation structural, so no width can bring the
                             overlap back. -->
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="BrightnessLegend" Grid.Row="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal" Margin="6,4,6,2" />
                    <Canvas x:Name="BrightnessAxisGutter" Grid.Row="1" Grid.Column="0"
                            Margin="4,0,0,4" ClipToBounds="True" />
                    <Canvas x:Name="BrightnessCanvas" Grid.Row="1" Grid.Column="1"
                            Margin="0,0,6,4" ClipToBounds="True" />
                </Grid>
            </Border>

            <Grid Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <local:CameraPaneView x:Name="Pane0" Grid.Row="0" Grid.Column="0" DataContext="{Binding Channels[0]}"
                                      FullscreenRequested="Pane_FullscreenRequested"
                                      ApplyToAllRequested="Pane_ApplyToAllRequested" />
                <local:CameraPaneView x:Name="Pane1" Grid.Row="0" Grid.Column="1" DataContext="{Binding Channels[1]}"
                                      FullscreenRequested="Pane_FullscreenRequested"
                                      ApplyToAllRequested="Pane_ApplyToAllRequested" />
                <local:CameraPaneView x:Name="Pane2" Grid.Row="1" Grid.Column="0" DataContext="{Binding Channels[2]}"
                                      FullscreenRequested="Pane_FullscreenRequested"
                                      ApplyToAllRequested="Pane_ApplyToAllRequested" />
                <local:CameraPaneView x:Name="Pane3" Grid.Row="1" Grid.Column="1" DataContext="{Binding Channels[3]}"
                                      FullscreenRequested="Pane_FullscreenRequested"
                                      ApplyToAllRequested="Pane_ApplyToAllRequested" />
            </Grid>
        </DockPanel>

        <!-- Fullscreen overlay: single display bound to the selected camera -->
        <Grid x:Name="FullscreenOverlay" Visibility="Collapsed" Background="Black">
            <!-- The MILWPFDisplay is created lazily in code-behind (only with a valid DisplayId),
                 and RoiEditSurface adds the ROI rectangle and its handles to this grid. -->
            <Border x:Name="FullscreenBorder" Background="Black"
                    SizeChanged="FullscreenBorder_SizeChanged"
                    PreviewMouseLeftButtonDown="FullscreenBorder_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="FullscreenBorder_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="FullscreenBorder_PreviewMouseLeftButtonUp">
                <Grid x:Name="FullscreenContentGrid" />
            </Border>
            <Border Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Top"
                    CornerRadius="0,0,6,6" Padding="12,4">
                <TextBlock x:Name="FullscreenTitle" Foreground="White" FontSize="13"
                           Text="Double-click or press ESC to exit fullscreen" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="8">
                <ToggleButton x:Name="FullscreenRoiToggle" Content="⬚" Padding="10,4" Margin="0,0,6,0"
                              Checked="FullscreenRoiToggle_Changed" Unchecked="FullscreenRoiToggle_Changed"
                              ToolTip="ROI 편집 모드: 모서리·변을 끌어 크기 변경, 안쪽을 끌어 이동, 바깥을 끌어 새로 지정" />
                <Button Content="✕ Exit" Click="ExitFullscreen_Click" Padding="10,4" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
