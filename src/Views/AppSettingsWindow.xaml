<Window x:Class="MatroxFrameGrabber.Views.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" SizeToContent="Height"
        MinWidth="440" MaxHeight="900"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        ShowInTaskbar="False" WindowStartupLocation="Manual">
    <!--
      Replaces the "⚙ Rec" popup. It was called recording settings and held three rows, of which
      one was about recording: the ffmpeg path is a read-only diagnostic and the display rate is
      about the preview. Meanwhile the output folder lived on the toolbar, and the recording
      backend had nowhere to go at all.

      A window rather than a popup because the list only grows from here, and because the
      per-camera settings already open in one - two kinds of settings in two kinds of container
      was the confusing part.

      Not modal, like the camera window: a folder or a rate is often changed while watching what
      it does.

      Labels in English with Korean tooltips, which is this app's convention. The popup this
      replaces had drifted into Korean labels for two of its three rows.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,14,14">
        <StackPanel Grid.IsSharedSizeScope="True">

            <!-- ============ RECORDING ============ -->
            <TextBlock Text="RECORDING" Foreground="#6F6F6F" FontSize="10" Margin="0,2,0,5" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="AppSettingsLabel" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Library" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton GroupName="Sink" Content="FFMPEG" Margin="0,0,14,0"
                                 IsChecked="{Binding SinkIsFfmpeg}"
                                 ToolTip="외부 ffmpeg 프로세스로 인코딩합니다" />
                    <RadioButton GroupName="Sink" Content="MIL"
                                 IsChecked="{Binding SinkIsMil}"
                                 IsEnabled="{Binding MilSinkSelectable}"
                                 ToolTip="{Binding MilSinkReason}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding SinkReasonText}" Margin="0,0,0,8"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="10"
                       TextWrapping="Wrap"
                       ToolTip="다음 시작부터 적용됩니다 — 싱크는 카메라를 할당할 때 정해집니다" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="AppSettingsLabel" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Source" />
                <TextBlock Grid.Column="1" Text="{Binding RecordingSourceText}"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"
                           ToolTip="녹화는 취득을 따릅니다 — 가장 빠른 것이 카메라가 주는 레이트이고, 크기도 카메라가 주는 크기입니다" />
            </Grid>

            <!-- ============ FOLDERS ============ -->
            <TextBlock Text="FOLDERS" Foreground="#6F6F6F" FontSize="10" Margin="0,4,0,5" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="AppSettingsLabel" Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Output" />
                <TextBox Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center"
                         Text="{Binding Output.OutputFolder, Mode=OneWay}"
                         ToolTip="{Binding Output.OutputFolder}" />
                <Button Grid.Column="2" Content="Browse…" Margin="4,0,0,0" Click="BrowseOutput_Click"
                        ToolTip="스냅샷과 녹화가 저장되는 폴더" />
                <Button Grid.Column="3" Content="Open" Margin="4,0,0,0" Click="OpenOutput_Click" />
            </Grid>

            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="AppSettingsLabel" Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Segments" />
                <TextBox Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center"
                         Text="{Binding Output.SegmentFolder, Mode=OneWay}"
                         ToolTip="{Binding Output.SegmentFolder}" />
                <Button Grid.Column="2" Content="Browse…" Margin="4,0,0,0" Click="BrowseSegments_Click"
                        ToolTip="사건 클립을 잘라낼 롤링 세그먼트가 쓰이는 곳" />
            </Grid>
            <TextBlock Text="keep this local — a network share becomes skipped frames, and a skipped frame is a hole in the clip"
                       Foreground="#5A5A5A" FontSize="10" Margin="0,0,0,10" TextWrapping="Wrap" />

            <!-- ============ ANOMALY CLIP ============ -->
            <TextBlock Text="ANOMALY CLIP" Foreground="#6F6F6F" FontSize="10" Margin="0,4,0,5" />

            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="AppSettingsLabel" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Around event" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="52" VerticalContentAlignment="Center"
                             Text="{Binding Output.AnomalyClipSeconds, UpdateSourceTrigger=LostFocus}"
                             ToolTip="사건 전후로 남길 초. 0 = 사건 클립 끔&#x0a;링 보존 시간은 여기서 유도됩니다 — 따로 두면 창보다 짧은 링이 만들어져 클립이 조용히 짧아집니다" />
                    <TextBlock Text="s before and after  ·  0 = off"
                               Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                </StackPanel>
            </Grid>
            <TextBlock Text="the ring keeps this window plus the event cap and one segment; it runs with the grab, not with Rec"
                       Foreground="#5A5A5A" FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap" />

            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="AppSettingsLabel" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Stills" />
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          Content="4 lossless PNG per anomaly"
                          IsChecked="{Binding Output.KeepStills}"
                          ToolTip="reference / onset / extreme / recovered&#x0a;클립은 x264 CRF 23이라 그 파일로는 보고된 편차를 재현할 수 없습니다. 무손실 정지화면은 됩니다" />
            </Grid>
            <TextBlock Text="the clip is lossy, so the numbers cannot be re-measured from it — these can"
                       Foreground="#5A5A5A" FontSize="10" Margin="0,0,0,10" TextWrapping="Wrap" />

            <!-- ============ DISPLAY ============ -->
            <TextBlock Text="DISPLAY" Foreground="#6F6F6F" FontSize="10" Margin="0,4,0,5" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="AppSettingsLabel" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Preview rate" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="52" VerticalContentAlignment="Center"
                             Text="{Binding Output.DisplayUpdateFps, UpdateSourceTrigger=LostFocus}"
                             ToolTip="0 = 무제한. 취득 fps와 무관하며, 화면 갱신 비용만 줄입니다" />
                    <TextBlock Text="fps  ·  0 = uncapped, unrelated to acquisition"
                               Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
