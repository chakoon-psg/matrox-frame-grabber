<UserControl x:Class="MatroxFrameGrabber.Views.CameraSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Grid.IsSharedSizeScope="True">
    <!--
      One camera's settings, hosted either inside its pane's Settings expander or in a window of
      its own. The same control and the same CameraChannel either way: the window is a second view
      of one view-model rather than a reparented control, so nothing moves in the visual tree.

      Why a window at all. The Calib row's text runs to about 600 px and a pane is 360, so in the
      pane it is clipped and has to be read from a tooltip. Widening the pane is not available -
      four of them share the window - and shortening the text would remove the provenance that is
      the point of it. The spare width also lets the rows that had to hide figures in tooltips show
      them: the frame period behind a debounce, the PWM null behind an exposure.

      Rows are grouped by what they belong to rather than left in one flat stack of eleven, and the
      label column is shared (SharedSizeGroup) so every group lines up on one left edge.
    -->
    <StackPanel>
        <!-- Copy this camera's capture settings (exposure / acq rate / trigger / WB) to every
             other present camera at once. -->
        <Button HorizontalAlignment="Left" Margin="0,0,0,6" Click="ApplyAll_Click"
                IsEnabled="{Binding CameraPresent}"
                ToolTip="이 카메라의 노출·Acq Rate·트리거·화이트밸런스를 다른 모든 카메라에 적용">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="이 설정을 전체 카메라에 적용" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- ─────────────── Camera ─────────────── -->
        <TextBlock Text="CAMERA" Foreground="#6F6F6F" FontSize="10" Margin="0,2,0,3" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Exp" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                <TextBox Width="60" FontSize="11" VerticalContentAlignment="Center"
                         Text="{Binding ExposureInput, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanSetExposureManually}"
                         Tag="exposure" KeyDown="SettingsField_KeyDown" />
                <TextBlock Text="{Binding ExposureRangeHint}" Margin="4,0,6,0"
                           VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                <Button Content="Apply" Click="ApplyExposure_Click"
                        IsEnabled="{Binding CanSetExposureManually}" />
                <CheckBox Content="Auto" Margin="4,0,0,0"
                          IsChecked="{Binding ExposureAuto}"
                          IsEnabled="{Binding SupportsExposureAuto}" />
            </StackPanel>

            <Label Grid.Row="1" Grid.Column="0" Content="Acq Rate" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                <CheckBox Content="Limit" Width="52" IsChecked="{Binding AcqRateEnabled}"
                          IsEnabled="{Binding SupportsAcqRateEnable}" />
                <TextBox Width="46" FontSize="11" VerticalContentAlignment="Center"
                         Text="{Binding AcqRateInput, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanSetAcqRate}"
                         Tag="acqrate" KeyDown="SettingsField_KeyDown" />
                <TextBlock Text="{Binding AcqRateHint}" Margin="4,0,6,0"
                           VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                <Button Content="Apply" Click="ApplyAcqRate_Click"
                        IsEnabled="{Binding CanSetAcqRate}" />
            </StackPanel>

            <!-- On-board decimation. The only lever that reduces host DMA traffic on this camera —
                 cropping is accepted and ignored (see CLAUDE.md). Changing it reallocates the
                 digitizer and buffers, so the grab briefly stops. -->
            <Label Grid.Row="2" Grid.Column="0" Content="Decim" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                <ComboBox Width="52" FontSize="11"
                          ItemsSource="{Binding DecimationOptions}"
                          SelectedItem="{Binding Decimation, Mode=OneWay}"
                          SelectionChanged="Decimation_Changed"
                          IsEnabled="{Binding SupportsDecimation}" />
                <TextBlock Text="{Binding DecimationHint}" Margin="6,0,0,0"
                           VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
            </StackPanel>
        </Grid>

        <!-- ─────────────── Detection ─────────────── -->
        <TextBlock Text="DETECTION" Foreground="#6F6F6F" FontSize="10" Margin="0,6,0,3" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Detection region: which pixels the anomaly metrics are computed over. Software
                 only — no reallocation, and the camera cannot refuse it. 0 width or height means
                 the whole frame. The green overlay rectangle in the pane shows the result, which
                 is why the drag-to-edit toggle stays there and only the numbers live here. -->
            <Label Grid.Row="0" Grid.Column="0" Content="ROI" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                <TextBox Width="44" FontSize="11" VerticalContentAlignment="Center"
                         Tag="roi" KeyDown="SettingsField_KeyDown"
                         Text="{Binding RoiInX, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="OffsetX in frame coordinates" />
                <TextBox Width="44" Margin="2,0,0,0" FontSize="11" VerticalContentAlignment="Center"
                         Tag="roi" KeyDown="SettingsField_KeyDown"
                         Text="{Binding RoiInY, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="OffsetY in frame coordinates" />
                <TextBlock Text="+" Margin="3,0" VerticalAlignment="Center" Foreground="#9A9A9A" />
                <TextBox Width="50" FontSize="11" VerticalContentAlignment="Center"
                         Tag="roi" KeyDown="SettingsField_KeyDown"
                         Text="{Binding RoiInW, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Width (0 = whole frame)" />
                <TextBox Width="50" Margin="2,0,0,0" FontSize="11" VerticalContentAlignment="Center"
                         Tag="roi" KeyDown="SettingsField_KeyDown"
                         Text="{Binding RoiInH, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Height (0 = whole frame)" />
                <TextBlock Text="{Binding AnalysisRoiHint}" Margin="4,0,6,0"
                           VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                <Button Content="Apply" Click="ApplyRoi_Click" />
                <Button Content="Full" Margin="2,0,0,0" Click="ClearRoi_Click"
                        ToolTip="Measure the whole frame" />
            </StackPanel>

            <!-- What this camera watches for, as a line. The checkboxes are in the app settings,
                 because which faults the rig looks for is one policy rather than four - a rig where
                 camera 1 watches for Blackout and camera 2 does not produces a report nobody can
                 read. What stays per camera is below: the thresholds, which had to be measured per
                 optical path.

                 The count of what is off is on purpose. Naming only what is on would let a pane
                 with nothing to report read as "nothing wrong" while six of seven kinds go
                 unexamined. -->
            <Label Grid.Row="1" Grid.Column="0" Content="Watching" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetectionKindsText}"
                       VerticalAlignment="Center" Margin="0,2,0,5" FontSize="11"
                       Foreground="#9A9A9A" TextTrimming="CharacterEllipsis"
                       ToolTip="검출 종류는 앱 전체 설정에서 켜고 끕니다 — 임계값은 카메라마다 따로입니다" />

            <!-- Detection thresholds. Per channel because the cameras do not see the same thing:
                 measured against one clip, the dimmest of three produced nine shallow false
                 positives where the other two produced none. Takes effect on the next Start.

                 Labelled with the kind it edits: it is Dropout's pair, and the four other kinds
                 are listed above it. -->
            <Label Grid.Row="2" Grid.Column="0" Content="Dropout" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                <TextBlock Text="depth" Margin="0,0,3,0" VerticalAlignment="Center"
                           Foreground="#9A9A9A" FontSize="10" />
                <TextBox Width="50" FontSize="11" VerticalContentAlignment="Center"
                         Tag="detect" KeyDown="SettingsField_KeyDown"
                         Text="{Binding DepthInput, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="How far brightness must fall to count, as a fraction of the baseline" />
                <TextBlock Text="coh" Margin="6,0,3,0" VerticalAlignment="Center"
                           Foreground="#9A9A9A" FontSize="10" />
                <TextBox Width="50" FontSize="11" VerticalContentAlignment="Center"
                         Tag="detect" KeyDown="SettingsField_KeyDown"
                         Text="{Binding CoherenceInput, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="How much the tiles must agree before a fall is believed" />
                <TextBlock Text="{Binding DetectionHint}" Margin="6,0,6,0"
                           VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                <Button Content="Apply" Click="ApplyThresholds_Click"
                        ToolTip="Saved to settings; takes effect on the next Start" />
            </StackPanel>

            <!-- Blackout's three, and they are luma rather than a fraction. Its own row because
                 it is its own detector: Dropout measures a fall against a running baseline and
                 confirms on one frame, this measures an absolute level with hysteresis and must
                 not. Sharing the row would suggest sharing the units, and 0.05 luma means "never
                 fire". -->
            <Label Grid.Row="3" Grid.Column="0" Content="Blackout" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                <TextBlock Text="dark≤" Margin="0,0,3,0" VerticalAlignment="Center"
                           Foreground="#9A9A9A" FontSize="10" />
                <TextBox Width="42" FontSize="11" VerticalContentAlignment="Center"
                         Tag="blackout" KeyDown="SettingsField_KeyDown"
                         Text="{Binding BlackoutEnterInput, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="화면이 사라진 것으로 볼 luma (0~255, 비율이 아님)&#x0a;실측: 작동 중인 패널은 121.6 / 90.4 / 36.9 luma로 바닥을 칩니다" />
                <TextBlock Text="back≥" Margin="6,0,3,0" VerticalAlignment="Center"
                           Foreground="#9A9A9A" FontSize="10" />
                <TextBox Width="42" FontSize="11" VerticalContentAlignment="Center"
                         Tag="blackout" KeyDown="SettingsField_KeyDown"
                         Text="{Binding BlackoutExitInput, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="화면이 돌아온 것으로 볼 luma. dark보다 높아야 합니다 — 그 간격이 히스테리시스이고, 없으면 경계에 앉은 패널이 몇 프레임마다 사건을 냅니다" />
                <TextBlock Text="flat≤" Margin="6,0,3,0" VerticalAlignment="Center"
                           Foreground="#9A9A9A" FontSize="10" />
                <TextBox Width="42" FontSize="11" VerticalContentAlignment="Center"
                         Tag="blackout" KeyDown="SettingsField_KeyDown"
                         Text="{Binding BlackoutSpreadInput, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="타일 평균의 범위. 이것이 꺼진 패널과 어두운 화면을 가릅니다&#x0a;어두운 화면도 화면이라 타일이 서로 다르고, 꺼진 패널은 센서 잡음뿐이라 타일이 일치합니다&#x0a;절대 레벨 캘리브레이션 없이도 동작하는 절반입니다" />
                <Button Content="Apply" Margin="6,0,0,0" Click="ApplyBlackout_Click"
                        ToolTip="Saved to settings; takes effect on the next Start" />
            </StackPanel>

            <!-- The live reading beside the levels, because "6 luma" says nothing until you can
                 see that this panel sits at 37 and keeps 40 of structure. -->
            <Label Grid.Row="4" Grid.Column="0" Content="" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BlackoutHint}" Margin="0,0,0,5"
                       VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding BlackoutHint}" />

            <!-- The budget and the share, because the split is invisible otherwise: five
                 detectors each allowed one false positive an hour is five an hour, and the total
                 is the number anybody was told to expect. -->
            <Label Grid.Row="5" Grid.Column="0" Content="Budget" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BudgetText}" Margin="0,0,0,3"
                       VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding BudgetText}" />

            <!-- Where the depth threshold came from, and what the last run would propose instead.
                 Applying is a separate act on purpose: the histogram is collected on every run
                 because it costs nothing, but only a person can say the run was on a healthy
                 panel. TextTrimming rather than a fixed width, so a window shows all of it and a
                 pane shows as much as it has room for. -->
            <Label Grid.Row="6" Grid.Column="0" Content="Calib" />
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding CalibrationText}" VerticalAlignment="Center"
                           Foreground="#9A9A9A" FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CalibrationText}" />
                <Button Content="Use proposal" Margin="6,0,0,0" Click="ApplyCalibration_Click"
                        IsEnabled="{Binding CanCalibrate}"
                        ToolTip="Only after a run on a known-good panel" />
            </StackPanel>
        </Grid>

        <!-- ─────────────── Advanced ─────────────── -->
        <!-- Collapsed by default: none of these is touched after the rig is commissioned. -->
        <Expander Header="ADVANCED" Foreground="#6F6F6F" FontSize="10"
                  IsExpanded="False" Margin="0,6,0,0">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Output name (used as snapshot/recording filename prefix) -->
                <Label Grid.Row="0" Grid.Column="0" Content="Name" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBox Width="140" FontSize="11" VerticalContentAlignment="Center"
                             Text="{Binding OutputName, UpdateSourceTrigger=LostFocus}"
                             ToolTip="File name prefix for snapshots/recordings" />
                    <TextBlock Text="_yyyyMMdd_HHmmss.png / .mp4·.mkv·.mov" Margin="6,0,0,0"
                               VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                </StackPanel>

                <Label Grid.Row="1" Grid.Column="0" Content="Trig" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                    <CheckBox Content="On" Width="38" IsChecked="{Binding TriggerOn}"
                              IsEnabled="{Binding SupportsTrigger}" />
                    <ComboBox Width="96" Margin="0,0,6,0" FontSize="11"
                              ItemsSource="{Binding TriggerSources}"
                              SelectedItem="{Binding SelectedTriggerSource}"
                              IsEnabled="{Binding SupportsTrigger}" />
                    <Button Content="Soft Trig" Click="SoftTrigger_Click"
                            IsEnabled="{Binding SupportsTrigger}" />
                </StackPanel>

                <Label Grid.Row="2" Grid.Column="0" Content="WB" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                    <CheckBox Content="Auto" Width="52" IsChecked="{Binding WhiteBalanceAuto}"
                              IsEnabled="{Binding SupportsWhiteBalance}" />
                    <Button Content="Once" Click="WhiteBalanceOnce_Click"
                            IsEnabled="{Binding SupportsWhiteBalance}" />
                    <Label Content="R" />
                    <TextBox Width="42" FontSize="11" Text="{Binding RedRatioInput, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanSetBalanceManually}"
                             Tag="balance" KeyDown="SettingsField_KeyDown" />
                    <Label Content="B" Margin="4,0,0,0" />
                    <TextBox Width="42" FontSize="11" Text="{Binding BlueRatioInput, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanSetBalanceManually}"
                             Tag="balance" KeyDown="SettingsField_KeyDown" />
                    <Button Content="Apply" Margin="4,0,0,0" Click="ApplyBalance_Click"
                            IsEnabled="{Binding CanSetBalanceManually}" />
                </StackPanel>

                <Label Grid.Row="3" Grid.Column="0" Content="DCF" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding DcfName}" Width="130" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="#9A9A9A" />
                    <Button Content="Load DCF…" Click="LoadDcf_Click" />
                    <Button Content="Features…" Click="FeatureBrowser_Click"
                            IsEnabled="{Binding CameraPresent}" />
                </StackPanel>
            </Grid>
        </Expander>
    </StackPanel>
</UserControl>
