<UserControl x:Class="MatroxFrameGrabber.Views.CameraPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:milwpf="milwpf">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="Padding" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="3">

        <!-- Header: camera name + per-camera toolbar -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
            <TextBlock Text="{Binding Name}" ToolTip="{Binding CameraInfo}"
                       Foreground="#4FC3F7" FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="▶ Start" Click="Start_Click" IsEnabled="{Binding CameraPresent}" />
                <Button Content="■ Stop" Click="Stop_Click" IsEnabled="{Binding CameraPresent}" />
                <Button Content="Snap" Click="Snapshot_Click" IsEnabled="{Binding CameraPresent}" />
                <Button Content="Fit" Click="Fit_Click" IsEnabled="{Binding CameraPresent}" />
                <Button Content="1:1" Click="OneToOne_Click" IsEnabled="{Binding CameraPresent}" />
                <Button Content="⤢" Click="Fullscreen_Click" ToolTip="Fullscreen (double-click view; ESC to return)" />
            </StackPanel>
        </Grid>

        <!-- Status -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}"
                   Foreground="#B0B0B0" FontSize="11" Margin="0,0,0,2" />

        <!-- Collapsible settings so the live view keeps maximum space -->
        <Expander DockPanel.Dock="Bottom" Header="Settings" Foreground="#D0D0D0"
                  IsExpanded="False" Margin="0,2,0,0">
            <Border Background="#2A2A2A" BorderBrush="#404040" BorderThickness="1" Padding="5">
                <StackPanel>
                    <!-- Exposure -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="Exp" Width="34" />
                        <TextBox Width="60" FontSize="11" VerticalContentAlignment="Center"
                                 Text="{Binding ExposureInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanSetExposureManually}" />
                        <TextBlock Text="{Binding ExposureRangeHint}" Margin="4,0,6,0"
                                   VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                        <Button Content="Apply" Click="ApplyExposure_Click"
                                IsEnabled="{Binding CanSetExposureManually}" />
                        <CheckBox Content="Auto" Margin="4,0,0,0"
                                  IsChecked="{Binding ExposureAuto}"
                                  IsEnabled="{Binding SupportsExposureAuto}" />
                    </StackPanel>

                    <!-- Trigger -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="Trig" Width="34" />
                        <CheckBox Content="On" Width="38" IsChecked="{Binding TriggerOn}"
                                  IsEnabled="{Binding SupportsTrigger}" />
                        <ComboBox Width="96" Margin="0,0,6,0" FontSize="11"
                                  ItemsSource="{Binding TriggerSources}"
                                  SelectedItem="{Binding SelectedTriggerSource}"
                                  IsEnabled="{Binding SupportsTrigger}" />
                        <Button Content="Soft Trig" Click="SoftTrigger_Click"
                                IsEnabled="{Binding SupportsTrigger}" />
                    </StackPanel>

                    <!-- White balance -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="WB" Width="34" />
                        <CheckBox Content="Auto" Width="52" IsChecked="{Binding WhiteBalanceAuto}"
                                  IsEnabled="{Binding SupportsWhiteBalance}" />
                        <Button Content="Once" Click="WhiteBalanceOnce_Click"
                                IsEnabled="{Binding SupportsWhiteBalance}" />
                        <Label Content="R" />
                        <TextBox Width="42" FontSize="11" Text="{Binding RedRatioInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanSetBalanceManually}" />
                        <Label Content="B" Margin="4,0,0,0" />
                        <TextBox Width="42" FontSize="11" Text="{Binding BlueRatioInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanSetBalanceManually}" />
                        <Button Content="Apply" Margin="4,0,0,0" Click="ApplyBalance_Click"
                                IsEnabled="{Binding CanSetBalanceManually}" />
                    </StackPanel>

                    <!-- DCF / feature browser -->
                    <StackPanel Orientation="Horizontal">
                        <Label Content="DCF" Width="34" />
                        <TextBlock Text="{Binding DcfName}" Width="130" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="#9A9A9A" />
                        <Button Content="Load DCF…" Click="LoadDcf_Click" />
                        <Button Content="Features…" Click="FeatureBrowser_Click"
                                IsEnabled="{Binding CameraPresent}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Expander>

        <!-- Live view (fills remaining space). The MILWPFDisplay is created in code-behind
             once a channel with a valid DisplayId is bound (an id-0 control errors in MIL).
             Double-click toggles fullscreen. -->
        <Border x:Name="ViewBorder" Background="Black" BorderBrush="#404040" BorderThickness="1"
                SizeChanged="ViewBorder_SizeChanged"
                PreviewMouseLeftButtonDown="ViewBorder_PreviewMouseLeftButtonDown" />
    </DockPanel>
</UserControl>
