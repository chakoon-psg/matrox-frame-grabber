<UserControl x:Class="MatroxFrameGrabber.Views.CameraPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:milwpf="milwpf">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="Padding" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Margin="3" Padding="5">
    <DockPanel>

        <!-- Header: [CAMn] port tag + editable name + per-camera toolbar -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border Background="{StaticResource ControlBrush}" CornerRadius="3" Padding="4,0" Margin="0,0,6,0">
                    <TextBlock Text="{Binding PortTag}" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding OutputName}" ToolTip="{Binding CameraInfo}"
                           Foreground="#4FC3F7" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="▶ Start" Command="{Binding StartCommand}" />
                <Button Content="■ Stop" Click="Stop_Click" IsEnabled="{Binding CameraPresent}"
                        Margin="0,0,10,0" ToolTip="Stop acquisition (confirms if recording)" />
                <ToggleButton Content="● Rec" Style="{StaticResource RecToggle}" FontSize="11"
                              Click="Record_Click" IsChecked="{Binding IsRecording, Mode=OneWay}"
                              IsEnabled="{Binding CanRecord}"
                              ToolTip="Live color H.264 recording — may drop frames at high fps" />
                <ToggleButton Content="◆ RAW" Style="{StaticResource RawToggle}" FontSize="11"
                              Click="RawRecord_Click" IsChecked="{Binding IsRawRecording, Mode=OneWay}"
                              IsEnabled="{Binding CanRecord}"
                              ToolTip="Lossless RAW recording: every frame at full fps → color MP4 (grayscale preview while recording)" />
                <Button Content="Snap" Click="Snapshot_Click" IsEnabled="{Binding CameraPresent}" Margin="10,0,3,0" />
                <Button Content="Fit" Command="{Binding FitCommand}" />
                <Button Content="1:1" Command="{Binding OneToOneCommand}" />
                <Button Content="⤢" Click="Fullscreen_Click" ToolTip="Fullscreen (double-click view; ESC to return)" />
            </StackPanel>
        </Grid>

        <!-- Status -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}"
                   Foreground="#B0B0B0" FontSize="11" Margin="0,0,0,2" />

        <!-- Collapsible settings so the live view keeps maximum space -->
        <Expander DockPanel.Dock="Bottom" Header="Settings" Foreground="#D0D0D0"
                  IsExpanded="False" Margin="0,2,0,0">
            <Border Background="#2A2A2A" BorderBrush="#404040" BorderThickness="1" Padding="5">
                <StackPanel>
                    <!-- Output name (used as snapshot/recording filename prefix) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="Name" Width="34" />
                        <TextBox Width="140" FontSize="11" VerticalContentAlignment="Center"
                                 Text="{Binding OutputName, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="File name prefix for snapshots/recordings" />
                        <TextBlock Text="_yyyyMMdd_HHmmss.png / .mp4" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                    </StackPanel>

                    <!-- Exposure -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="Exp" Width="34" />
                        <TextBox Width="60" FontSize="11" VerticalContentAlignment="Center"
                                 Text="{Binding ExposureInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanSetExposureManually}" />
                        <TextBlock Text="{Binding ExposureRangeHint}" Margin="4,0,6,0"
                                   VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                        <Button Content="Apply" Click="ApplyExposure_Click"
                                IsEnabled="{Binding CanSetExposureManually}" />
                        <CheckBox Content="Auto" Margin="4,0,0,0"
                                  IsChecked="{Binding ExposureAuto}"
                                  IsEnabled="{Binding SupportsExposureAuto}" />
                        <Button Content="≡ All" Click="ExposureAll_Click" Margin="8,0,0,0" FontSize="10"
                                IsEnabled="{Binding SupportsExposure}"
                                ToolTip="이 노출 설정을 모든 카메라에 적용" />
                    </StackPanel>

                    <!-- Acquisition frame-rate cap -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="Acq Rate" Width="52" />
                        <CheckBox Content="Limit" Width="52" IsChecked="{Binding AcqRateEnabled}"
                                  IsEnabled="{Binding SupportsAcqRateEnable}" />
                        <TextBox Width="46" FontSize="11" VerticalContentAlignment="Center"
                                 Text="{Binding AcqRateInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanSetAcqRate}" />
                        <TextBlock Text="{Binding AcqRateHint}" Margin="4,0,6,0"
                                   VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                        <Button Content="Apply" Click="ApplyAcqRate_Click"
                                IsEnabled="{Binding CanSetAcqRate}" />
                        <Button Content="≡ All" Click="AcqRateAll_Click" Margin="8,0,0,0" FontSize="10"
                                IsEnabled="{Binding SupportsAcqRate}"
                                ToolTip="이 Acq Rate 설정을 모든 카메라에 적용" />
                    </StackPanel>

                    <!-- Trigger -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="Trig" Width="34" />
                        <CheckBox Content="On" Width="38" IsChecked="{Binding TriggerOn}"
                                  IsEnabled="{Binding SupportsTrigger}" />
                        <ComboBox Width="96" Margin="0,0,6,0" FontSize="11"
                                  ItemsSource="{Binding TriggerSources}"
                                  SelectedItem="{Binding SelectedTriggerSource}"
                                  IsEnabled="{Binding SupportsTrigger}" />
                        <Button Content="Soft Trig" Click="SoftTrigger_Click"
                                IsEnabled="{Binding SupportsTrigger}" />
                        <Button Content="≡ All" Click="TriggerAll_Click" Margin="8,0,0,0" FontSize="10"
                                IsEnabled="{Binding SupportsTrigger}"
                                ToolTip="이 트리거 설정을 모든 카메라에 적용" />
                    </StackPanel>

                    <!-- White balance -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="WB" Width="34" />
                        <CheckBox Content="Auto" Width="52" IsChecked="{Binding WhiteBalanceAuto}"
                                  IsEnabled="{Binding SupportsWhiteBalance}" />
                        <Button Content="Once" Click="WhiteBalanceOnce_Click"
                                IsEnabled="{Binding SupportsWhiteBalance}" />
                        <Label Content="R" />
                        <TextBox Width="42" FontSize="11" Text="{Binding RedRatioInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanSetBalanceManually}" />
                        <Label Content="B" Margin="4,0,0,0" />
                        <TextBox Width="42" FontSize="11" Text="{Binding BlueRatioInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanSetBalanceManually}" />
                        <Button Content="Apply" Margin="4,0,0,0" Click="ApplyBalance_Click"
                                IsEnabled="{Binding CanSetBalanceManually}" />
                        <Button Content="≡ All" Click="WhiteBalanceAll_Click" Margin="8,0,0,0" FontSize="10"
                                IsEnabled="{Binding SupportsWhiteBalance}"
                                ToolTip="이 화이트밸런스 설정을 모든 카메라에 적용" />
                    </StackPanel>

                    <!-- DCF / feature browser -->
                    <StackPanel Orientation="Horizontal">
                        <Label Content="DCF" Width="34" />
                        <TextBlock Text="{Binding DcfName}" Width="130" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="#9A9A9A" />
                        <Button Content="Load DCF…" Click="LoadDcf_Click" />
                        <Button Content="Features…" Click="FeatureBrowser_Click"
                                IsEnabled="{Binding CameraPresent}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Expander>

        <!-- Live view (fills remaining space). The MILWPFDisplay is created in code-behind
             once a channel with a valid DisplayId is bound (an id-0 control errors in MIL).
             Double-click toggles fullscreen. A recording banner overlays the top edge. -->
        <Grid>
            <Border x:Name="ViewBorder" Background="Black" BorderBrush="#404040" BorderThickness="1"
                    SizeChanged="ViewBorder_SizeChanged"
                    PreviewMouseLeftButtonDown="ViewBorder_PreviewMouseLeftButtonDown" />

            <!-- Persistent recording banner: red = live H.264, orange = RAW lossless -->
            <Border VerticalAlignment="Top" Padding="8,4"
                    Visibility="{Binding RecordingActive, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource RecBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRawRecording}" Value="True">
                                <Setter Property="Background" Value="{StaticResource RawBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding RecordingBannerText}" Foreground="White"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </DockPanel>
    </Border>
</UserControl>
