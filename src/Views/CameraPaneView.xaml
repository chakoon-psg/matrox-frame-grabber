<UserControl x:Class="MatroxFrameGrabber.Views.CameraPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:milwpf="milwpf">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="Padding" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Margin="3" Padding="5">
    <DockPanel>

        <!-- Header: [CAMn] port tag + editable name + per-camera toolbar -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border Background="{StaticResource ControlBrush}" CornerRadius="3" Padding="4,0" Margin="0,0,6,0">
                    <TextBlock Text="{Binding PortTag}" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding OutputName}" ToolTip="{Binding CameraInfo}"
                           Foreground="#4FC3F7" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="▶ Start" Command="{Binding StartCommand}" />
                <Button Content="■ Stop" Click="Stop_Click" IsEnabled="{Binding IsGrabbing}"
                        Margin="0,0,10,0" ToolTip="Stop acquisition (confirms if recording)" />
                <ToggleButton Content="● Rec" Style="{StaticResource RecToggle}" FontSize="11"
                              Click="Record_Click" IsChecked="{Binding IsRecording, Mode=OneWay}"
                              IsEnabled="{Binding CanRecord}"
                              ToolTip="Live color H.264 recording — may drop frames at high fps" />
                <ToggleButton Content="◆ RAW" Style="{StaticResource RawToggle}" FontSize="11"
                              Click="RawRecord_Click" IsChecked="{Binding IsRawRecording, Mode=OneWay}"
                              IsEnabled="{Binding CanRecord}"
                              ToolTip="Lossless RAW recording: every frame at full fps → color MP4 (grayscale preview while recording)" />
                <!-- IsGrabbing, not CameraPresent: while stopped the display buffer still holds the
                     previous run's last frame, so a snapshot of it looks fresh but is not. -->
                <Button Content="Snap" Click="Snapshot_Click" IsEnabled="{Binding IsGrabbing}" Margin="10,0,3,0" />
                <Button Content="Fit" Command="{Binding FitCommand}" />
                <Button Content="1:1" Command="{Binding OneToOneCommand}" />
                <ToggleButton x:Name="RoiSelectToggle" Content="⬚" Padding="6,3"
                              Checked="RoiSelectToggle_Changed" Unchecked="RoiSelectToggle_Changed"
                              IsEnabled="{Binding CameraPresent}"
                              ToolTip="ROI 편집 모드: 모서리·변을 끌어 크기 변경, 안쪽을 끌어 이동, 바깥을 끌어 새로 지정 (켜져 있는 동안 줌·팬은 잠깁니다)" />
                <Button Content="⤢" Click="Fullscreen_Click" ToolTip="Fullscreen (double-click view; ESC to return)" />
            </StackPanel>
        </Grid>

        <!-- Status -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}"
                   Foreground="#B0B0B0" FontSize="11" Margin="0,0,0,2" />

        <!-- Collapsible settings so the live view keeps maximum space -->
        <Expander DockPanel.Dock="Bottom" Header="Settings" Foreground="#D0D0D0"
                  IsExpanded="False" Margin="0,2,0,0">
            <Border Background="#2A2A2A" BorderBrush="#404040" BorderThickness="1" Padding="5">
                <StackPanel>
                    <!-- Copy this camera's capture settings (exposure / acq rate / trigger / WB)
                         to every other present camera at once. -->
                    <Button HorizontalAlignment="Left" Margin="0,0,0,6" Click="ApplyAll_Click"
                            IsEnabled="{Binding CameraPresent}"
                            ToolTip="이 카메라의 노출·Acq Rate·트리거·화이트밸런스를 다른 모든 카메라에 적용">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="이 설정을 전체 카메라에 적용" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Output name (used as snapshot/recording filename prefix) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="Name" Width="34" />
                        <TextBox Width="140" FontSize="11" VerticalContentAlignment="Center"
                                 Text="{Binding OutputName, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="File name prefix for snapshots/recordings" />
                        <TextBlock Text="_yyyyMMdd_HHmmss.png / .mp4" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                    </StackPanel>

                    <!-- Exposure -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="Exp" Width="34" />
                        <TextBox Width="60" FontSize="11" VerticalContentAlignment="Center"
                                 Text="{Binding ExposureInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanSetExposureManually}"
                                 Tag="exposure" KeyDown="SettingsField_KeyDown" />
                        <TextBlock Text="{Binding ExposureRangeHint}" Margin="4,0,6,0"
                                   VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                        <Button Content="Apply" Click="ApplyExposure_Click"
                                IsEnabled="{Binding CanSetExposureManually}" />
                        <CheckBox Content="Auto" Margin="4,0,0,0"
                                  IsChecked="{Binding ExposureAuto}"
                                  IsEnabled="{Binding SupportsExposureAuto}" />
                    </StackPanel>

                    <!-- Acquisition frame-rate cap -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="Acq Rate" Width="52" />
                        <CheckBox Content="Limit" Width="52" IsChecked="{Binding AcqRateEnabled}"
                                  IsEnabled="{Binding SupportsAcqRateEnable}" />
                        <TextBox Width="46" FontSize="11" VerticalContentAlignment="Center"
                                 Text="{Binding AcqRateInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanSetAcqRate}"
                                 Tag="acqrate" KeyDown="SettingsField_KeyDown" />
                        <TextBlock Text="{Binding AcqRateHint}" Margin="4,0,6,0"
                                   VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                        <Button Content="Apply" Click="ApplyAcqRate_Click"
                                IsEnabled="{Binding CanSetAcqRate}" />
                    </StackPanel>

                    <!-- Trigger -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="Trig" Width="34" />
                        <CheckBox Content="On" Width="38" IsChecked="{Binding TriggerOn}"
                                  IsEnabled="{Binding SupportsTrigger}" />
                        <ComboBox Width="96" Margin="0,0,6,0" FontSize="11"
                                  ItemsSource="{Binding TriggerSources}"
                                  SelectedItem="{Binding SelectedTriggerSource}"
                                  IsEnabled="{Binding SupportsTrigger}" />
                        <Button Content="Soft Trig" Click="SoftTrigger_Click"
                                IsEnabled="{Binding SupportsTrigger}" />
                    </StackPanel>

                    <!-- White balance -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="WB" Width="34" />
                        <CheckBox Content="Auto" Width="52" IsChecked="{Binding WhiteBalanceAuto}"
                                  IsEnabled="{Binding SupportsWhiteBalance}" />
                        <Button Content="Once" Click="WhiteBalanceOnce_Click"
                                IsEnabled="{Binding SupportsWhiteBalance}" />
                        <Label Content="R" />
                        <TextBox Width="42" FontSize="11" Text="{Binding RedRatioInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanSetBalanceManually}"
                                 Tag="balance" KeyDown="SettingsField_KeyDown" />
                        <Label Content="B" Margin="4,0,0,0" />
                        <TextBox Width="42" FontSize="11" Text="{Binding BlueRatioInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanSetBalanceManually}"
                                 Tag="balance" KeyDown="SettingsField_KeyDown" />
                        <Button Content="Apply" Margin="4,0,0,0" Click="ApplyBalance_Click"
                                IsEnabled="{Binding CanSetBalanceManually}" />
                    </StackPanel>

                    <!-- On-board decimation. The only lever that reduces host DMA traffic on this
                         camera — cropping is accepted and ignored (see CLAUDE.md). Changing it
                         reallocates the digitizer and buffers, so the grab briefly stops. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="Decim" Width="42" />
                        <ComboBox Width="52" FontSize="11"
                                  ItemsSource="{Binding DecimationOptions}"
                                  SelectedItem="{Binding Decimation, Mode=OneWay}"
                                  SelectionChanged="Decimation_Changed"
                                  IsEnabled="{Binding SupportsDecimation}" />
                        <TextBlock Text="{Binding DecimationHint}" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                    </StackPanel>

                    <!-- Analysis ROI: which pixels the anomaly metrics are computed over. Software
                         only — no reallocation, and the camera cannot refuse it. 0 width or height
                         means the whole frame. The green overlay rectangle shows the result. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Label Content="ROI" Width="42" />
                        <TextBox Width="44" FontSize="11" VerticalContentAlignment="Center"
                                 Tag="roi" KeyDown="SettingsField_KeyDown"
                                 Text="{Binding RoiInX, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="OffsetX in frame coordinates" />
                        <TextBox Width="44" Margin="2,0,0,0" FontSize="11" VerticalContentAlignment="Center"
                                 Tag="roi" KeyDown="SettingsField_KeyDown"
                                 Text="{Binding RoiInY, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="OffsetY in frame coordinates" />
                        <TextBlock Text="+" Margin="3,0" VerticalAlignment="Center" Foreground="#9A9A9A" />
                        <TextBox Width="50" FontSize="11" VerticalContentAlignment="Center"
                                 Tag="roi" KeyDown="SettingsField_KeyDown"
                                 Text="{Binding RoiInW, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Width (0 = whole frame)" />
                        <TextBox Width="50" Margin="2,0,0,0" FontSize="11" VerticalContentAlignment="Center"
                                 Tag="roi" KeyDown="SettingsField_KeyDown"
                                 Text="{Binding RoiInH, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Height (0 = whole frame)" />
                        <TextBlock Text="{Binding AnalysisRoiHint}" Margin="4,0,6,0"
                                   VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                        <Button Content="Apply" Click="ApplyRoi_Click" />
                        <Button Content="Full" Margin="2,0,0,0" Click="ClearRoi_Click"
                                ToolTip="Measure the whole frame" />
                    </StackPanel>

                    <!-- Detection thresholds. Per channel because the cameras do not see the same
                         thing: measured against one clip, the dimmest of three produced nine
                         shallow false positives where the other two produced none. Takes effect on
                         the next Start, not the run in progress. -->
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Detect" Width="42" />
                        <TextBlock Text="depth" Margin="0,0,3,0" VerticalAlignment="Center"
                                   Foreground="#9A9A9A" FontSize="10" />
                        <TextBox Width="50" FontSize="11" VerticalContentAlignment="Center"
                                 Tag="detect" KeyDown="SettingsField_KeyDown"
                                 Text="{Binding DepthInput, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="How far brightness must fall to count, as a fraction of the baseline" />
                        <TextBlock Text="coh" Margin="6,0,3,0" VerticalAlignment="Center"
                                   Foreground="#9A9A9A" FontSize="10" />
                        <TextBox Width="50" FontSize="11" VerticalContentAlignment="Center"
                                 Tag="detect" KeyDown="SettingsField_KeyDown"
                                 Text="{Binding CoherenceInput, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="How much the tiles must agree before a fall is believed" />
                        <TextBlock Text="{Binding DetectionHint}" Margin="6,0,6,0"
                                   VerticalAlignment="Center" Foreground="#9A9A9A" FontSize="10" />
                        <Button Content="Apply" Click="ApplyThresholds_Click"
                                ToolTip="Saved to settings; takes effect on the next Start" />
                    </StackPanel>

                    <!-- Where the depth threshold came from, and what the last run would propose
                         instead. Applying is a separate act on purpose: the histogram is collected
                         every run because it is free, but only a person can say the run was on a
                         healthy panel. -->
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Calib" Width="42" />
                        <TextBlock Text="{Binding CalibrationText}" VerticalAlignment="Center"
                                   Foreground="#9A9A9A" FontSize="10" Width="300"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CalibrationText}" />
                        <Button Content="Use proposal" Margin="4,0,0,0" Click="ApplyCalibration_Click"
                                IsEnabled="{Binding CanCalibrate}"
                                ToolTip="Only after a run on a known-good panel" />
                    </StackPanel>

                    <!-- DCF / feature browser -->
                    <StackPanel Orientation="Horizontal">
                        <Label Content="DCF" Width="34" />
                        <TextBlock Text="{Binding DcfName}" Width="130" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="#9A9A9A" />
                        <Button Content="Load DCF…" Click="LoadDcf_Click" />
                        <Button Content="Features…" Click="FeatureBrowser_Click"
                                IsEnabled="{Binding CameraPresent}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Expander>

        <!-- Live view (fills remaining space). The MILWPFDisplay is created in code-behind
             once a channel with a valid DisplayId is bound (an id-0 control errors in MIL).
             Double-click toggles fullscreen. A recording banner overlays the top edge. -->
        <Grid>
            <Border x:Name="ViewBorder" Background="Black" BorderBrush="#404040" BorderThickness="1"
                    SizeChanged="ViewBorder_SizeChanged"
                    PreviewMouseLeftButtonDown="ViewBorder_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ViewBorder_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="ViewBorder_PreviewMouseLeftButtonUp">
                <Grid x:Name="ViewContentGrid">
                    <!-- The ROI rectangle and its eight handles are added here by RoiEditSurface. -->
                </Grid>
            </Border>

            <!-- Persistent recording banner: red = live H.264, orange = RAW lossless -->
            <Border VerticalAlignment="Top" Padding="8,4"
                    Visibility="{Binding RecordingActive, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource RecBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRawRecording}" Value="True">
                                <Setter Property="Background" Value="{StaticResource RawBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding RecordingBannerText}" Foreground="White"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </DockPanel>
    </Border>
</UserControl>
