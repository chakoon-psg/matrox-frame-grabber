<UserControl x:Class="MatroxFrameGrabber.Views.CameraPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:milwpf="milwpf"
             xmlns:local="clr-namespace:MatroxFrameGrabber.Views">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="Padding" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Margin="3" Padding="5">
    <DockPanel>

        <!-- Header: [CAMn] port tag + editable name + per-camera toolbar -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border Background="{StaticResource ControlBrush}" CornerRadius="3" Padding="4,0" Margin="0,0,6,0">
                    <TextBlock Text="{Binding PortTag}" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding OutputName}" ToolTip="{Binding CameraInfo}"
                           Foreground="#4FC3F7" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="▶ Start" Command="{Binding StartCommand}" />
                <Button Content="■ Stop" Click="Stop_Click" IsEnabled="{Binding IsGrabbing}"
                        Margin="0,0,10,0" ToolTip="Stop acquisition (confirms if recording)" />
                <ToggleButton Content="● Rec" Style="{StaticResource RecToggle}" FontSize="11"
                              Click="Record_Click" IsChecked="{Binding IsRecording, Mode=OneWay}"
                              IsEnabled="{Binding CanRecord}"
                              ToolTip="{Binding RecordBackend, StringFormat='라이브 H.264 녹화 · {0}'}" />
                <!-- IsGrabbing, not CameraPresent: while stopped the display buffer still holds the
                     previous run's last frame, so a snapshot of it looks fresh but is not. -->
                <Button Content="Snap" Click="Snapshot_Click" IsEnabled="{Binding IsGrabbing}" Margin="10,0,3,0" />
                <Button Content="Fit" Command="{Binding FitCommand}" />
                <Button Content="1:1" Command="{Binding OneToOneCommand}" />
                <ToggleButton x:Name="RoiSelectToggle" Content="⬚" Padding="6,3"
                              Checked="RoiSelectToggle_Changed" Unchecked="RoiSelectToggle_Changed"
                              IsEnabled="{Binding CameraPresent}"
                              ToolTip="ROI 편집 모드: 모서리·변을 끌어 크기 변경, 안쪽을 끌어 이동, 바깥을 끌어 새로 지정 (켜져 있는 동안 줌·팬은 잠깁니다)" />
                <Button Content="⤢" Click="Fullscreen_Click" ToolTip="Fullscreen (double-click view; ESC to return)" />
            </StackPanel>
        </Grid>

        <!-- Status -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}"
                   Foreground="#B0B0B0" FontSize="11" Margin="0,0,0,2" />

        <!-- Collapsible settings so the live view keeps maximum space.
             The rows themselves live in CameraSettingsView, which the same channel also drives in
             a window of its own — see PopOut_Click. The button sits in the header rather than in
             the body so it can be reached while the expander is closed, which is the usual state.
        -->
        <Expander x:Name="SettingsExpander" DockPanel.Dock="Bottom" Foreground="#D0D0D0"
                  IsExpanded="False" Margin="0,2,0,0">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                    <Button Content="&#x2750;" Margin="8,0,0,0" Padding="5,0" FontSize="11"
                            Click="PopOut_Click"
                            ToolTip="별도 창으로 열기 (pane 폭에 안 들어가는 값까지 보입니다)" />
                </StackPanel>
            </Expander.Header>
            <Border Background="#2A2A2A" BorderBrush="#404040" BorderThickness="1" Padding="5">
                <!-- Scrolls, because a pane is not tall enough for the whole list and an expander
                     docked to the bottom of one just stops drawing where the pane ends. A
                     scrollbar says there is more; the pop-out window shows all of it. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                    <local:CameraSettingsView x:Name="InlineSettings" />
                </ScrollViewer>
            </Border>
        </Expander>

        <!-- Live view (fills remaining space). The MILWPFDisplay is created in code-behind
             once a channel with a valid DisplayId is bound (an id-0 control errors in MIL).
             Double-click toggles fullscreen. A recording banner overlays the top edge. -->
        <Grid>
            <Border x:Name="ViewBorder" Background="Black" BorderBrush="#404040" BorderThickness="1"
                    SizeChanged="ViewBorder_SizeChanged"
                    PreviewMouseLeftButtonDown="ViewBorder_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ViewBorder_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="ViewBorder_PreviewMouseLeftButtonUp">
                <Grid x:Name="ViewContentGrid">
                    <!-- The ROI rectangle and its eight handles are added here by RoiEditSurface. -->
                </Grid>
            </Border>

            <!-- Persistent recording banner while a live H.264 recording is running -->
            <Border VerticalAlignment="Top" Padding="8,4"
                    Background="{StaticResource RecBrush}"
                    Visibility="{Binding RecordingActive, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding RecordingBannerText}" Foreground="White"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </DockPanel>
    </Border>
</UserControl>
