<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0-windows: net6.0 went out of support, so it is no longer a safe floor. The MIL
         NuGet packages ship net6.0 / net6.0-windows7.0 assets, which a higher TFM consumes
         unchanged — the upgrade costs nothing on the MIL side. The consequence is on deployment:
         field PCs need the WindowsDesktop 10.0 runtime, not 6.0 (see README prerequisites).
         The MIL NuGet packages only support x64/arm64, so the whole app is pinned to x64. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the folder-picker dialog (FolderBrowserDialog). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <!-- Platform, not just Platforms. Platforms only lists what is offered; without a default,
         building this project directly (rather than through the solution) gets AnyCPU and writes
         to bin\Release\ instead of bin\x64\Release\. Two output folders is how somebody ends up
         running a stale exe and concluding their change did nothing — which happened here.
         AnyCPU is meaningless anyway: the MIL packages are x64-only. A global property from the
         solution or -p:Platform= still wins over this, which is the behaviour we want. -->
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>MatroxFrameGrabber</RootNamespace>
    <AssemblyName>MatroxFrameGrabber</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Matrox.MatroxImagingLibrary" Version="10.*" />
    <PackageReference Include="Matrox.MatroxImagingLibrary.WPF" Version="10.*" />
  </ItemGroup>

  <!-- Include ffmpeg license files in the output folder.
       The output folder is handed to the customer as-is, so licenses must travel with it. -->
  <ItemGroup>
    <None Include="..\LICENSES\**\*" LinkBase="LICENSES" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ffmpeg is a runtime dependency and does not arrive through NuGet. The build stages it
       into the output folder so the app runs against the same binary regardless of which
       account is logged in or what winget has installed.
       Design: docs/superpowers/specs/2026-08-19-ffmpeg-bundling-design.md -->
  <PropertyGroup>
    <FfmpegToolPath>$(MSBuildProjectDirectory)\..\tools\ffmpeg\ffmpeg.exe</FfmpegToolPath>
  </PropertyGroup>

  <Target Name="EnsureFfmpegTool" BeforeTargets="BeforeBuild"
          Condition="!Exists('$(FfmpegToolPath)')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\fetch-ffmpeg.ps1&quot;"
          ContinueOnError="true" UseUtf8Encoding="Always" />
    <Warning Condition="!Exists('$(FfmpegToolPath)')"
             Text="ffmpeg.exe를 찾지 못해 산출물에 동봉하지 않습니다. 'winget install Gyan.FFmpeg' 후 다시 빌드하거나 tools/ffmpeg/ 에 직접 넣으세요. 녹화는 런타임 탐색 결과에 따라 동작할 수도, 비활성화될 수도 있습니다." />
  </Target>

  <Target Name="CopyFfmpegToOutput" AfterTargets="Build"
          Condition="Exists('$(FfmpegToolPath)')">
    <Copy SourceFiles="$(FfmpegToolPath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- `dotnet publish` computes its own file list, so the output-folder copy above does not
       reach it. Without this the publish folder would carry ffmpeg's licence notice and not
       ffmpeg itself. -->
  <Target Name="AddFfmpegToPublish" BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="Exists('$(FfmpegToolPath)')">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(FfmpegToolPath)"
                             RelativePath="ffmpeg.exe"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
