<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- No WPF and no WinForms: this harness has no window, which is the point. The MIL NuGet
         packages ship net6.0 assets that a higher TFM consumes unchanged, and they are x64-only,
         so Platform is pinned as well as Platforms - see the app csproj for why both are needed. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>MilVideoSinkHarness</RootNamespace>
    <AssemblyName>MilVideoSink</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The shared files come from src/ and carry their own namespaces. -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Matrox.MatroxImagingLibrary" Version="10.*" />
  </ItemGroup>

  <!-- Source-included from the application rather than copied, so there is one version of the
       contract and of the sink under development. A file returned by whoever implements
       MilSeqVideoSink drops back into the app with no edit, because both projects compile the
       same file. See README.md for the exact list to hand over. -->
  <ItemGroup>
    <Compile Include="..\..\src\Mil\Video\IVideoSink.cs" LinkBase="Shared" />
    <Compile Include="..\..\src\Mil\Video\VideoStreamSpec.cs" LinkBase="Shared" />
    <Compile Include="..\..\src\Mil\Video\VideoSinkStats.cs" LinkBase="Shared" />
    <Compile Include="..\..\src\Mil\Video\MilSeqVideoSink.cs" LinkBase="Shared" />
    <Compile Include="..\..\src\Mil\Video\FfmpegVideoSink.cs" LinkBase="Shared" />
    <Compile Include="..\..\src\Mil\GenICamFeatures.cs" LinkBase="Shared" />
    <Compile Include="..\..\src\Infrastructure\MilErrorLog.cs" LinkBase="Shared" />
    <Compile Include="..\..\src\Infrastructure\FfmpegRecorder.cs" LinkBase="Shared" />
    <Compile Include="..\..\src\Infrastructure\Video\FfmpegArgs.cs" LinkBase="Shared" />
    <Compile Include="..\..\src\Infrastructure\Video\VideoRatePolicy.cs" LinkBase="Shared" />
    <Compile Include="..\..\src\Infrastructure\Video\VideoEncoding.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
